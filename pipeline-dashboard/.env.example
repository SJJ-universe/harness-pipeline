# pipeline-dashboard/.env — copy to .env (gitignored) and edit locally.
# This file is the canonical reference for every env var the harness reads.
# Lines starting with # are commented-out defaults; uncomment + set a value
# to override.
#
# Quickstart:
#   cp .env.example .env
#   # then optionally edit .env
#   npm start

# ─────────────────────────────────────────────────────────────────
# Network + auth (Slice S1, Phase 3-S)
# ─────────────────────────────────────────────────────────────────

# ORCHESTRATOR_HOST
#   Default: 127.0.0.1 (loopback-only — safe local dev).
#   Set to 0.0.0.0 to bind on all interfaces (Docker, LAN). When you do
#   you SHOULD also set ORCHESTRATOR_ALLOW_REMOTE=1 + ORCHESTRATOR_TOKEN below —
#   otherwise the auth middleware rejects every non-loopback request and
#   the bind is effectively useless.
#ORCHESTRATOR_HOST=127.0.0.1

# ORCHESTRATOR_PORT
#   Dashboard HTTP+WS port. Default 4201.
#ORCHESTRATOR_PORT=4201

# ORCHESTRATOR_ALLOW_REMOTE
#   "1" enables non-loopback HTTP and WebSocket clients. Default "0"
#   (rejects every request whose remote address is not loopback). Required
#   together with a non-default ORCHESTRATOR_HOST for actual remote access.
#ORCHESTRATOR_ALLOW_REMOTE=0

# ORCHESTRATOR_TOKEN
#   When unset, src/security/auth.js auto-generates a 32-byte hex token on
#   first boot, stores it at .harness/local-token (mode 0o600), and the
#   server prints it once. The token is required by:
#     - mutating HTTP routes (POST/PUT/PATCH/DELETE) via header
#       X-Harness-Token: <token>
#     - non-loopback WebSocket upgrades via query param
#       ws://host:port/?token=<token>
#   Loopback (127.0.0.1 / ::1) requests ALWAYS bypass — local dev stays
#   frictionless. Pick a long random string for production:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#     openssl rand -hex 24
#ORCHESTRATOR_TOKEN=replace-with-long-random-hex

# ─────────────────────────────────────────────────────────────────
# Multi-run + child process limits (Phase 2.5)
# ─────────────────────────────────────────────────────────────────

# ORCHESTRATOR_MAX_RUNS
#   PipelineOrchestrator concurrent run cap. Default 3 (Slice A0 rollback).
#   Set 1 for single-active compatibility (legacy single-run users).
#ORCHESTRATOR_MAX_RUNS=3

# ORCHESTRATOR_CHILD_MAX
#   Shared semaphore cap for Codex + Claude child processes. Default 2.
#ORCHESTRATOR_CHILD_MAX=2

# ORCHESTRATOR_CHILD_QUEUE_TIMEOUT_MS
#   Per-acquire timeout when waiting on the child semaphore. Default 30000.
#ORCHESTRATOR_CHILD_QUEUE_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────
# Security / observability flags
# ─────────────────────────────────────────────────────────────────

# ORCHESTRATOR_CSP_MODE
#   "enforce" (default) or "report-only". Use report-only when relaxing
#   the CSP to debug a violation; flip back to enforce once /api/csp-report
#   is quiet.
#ORCHESTRATOR_CSP_MODE=enforce

# ORCHESTRATOR_DEBUG
#   "1" to enable verbose HookRouter console traces.
#ORCHESTRATOR_DEBUG=0

# ORCHESTRATOR_SAMPLE_HOOKS
#   "1" to dump every hook payload to fixtures/hooks/ for replay testing.
#   Async, fire-and-forget — never blocks hook processing.
#ORCHESTRATOR_SAMPLE_HOOKS=0

# ORCHESTRATOR_ENABLED
#   "1" to start the executor in enabled mode automatically.
#ORCHESTRATOR_ENABLED=0

# ─────────────────────────────────────────────────────────────────
# Path overrides (rarely needed)
# ─────────────────────────────────────────────────────────────────

# ORCHESTRATOR_WORKSPACE_DIR
#   Override pipeline executor's _workspace directory path.
#ORCHESTRATOR_WORKSPACE_DIR=

# ORCHESTRATOR_ROOT
#   Override the harness root used by the hook bridge.
#ORCHESTRATOR_ROOT=
