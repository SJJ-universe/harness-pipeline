# Slice R2-1 (Phase D R2 deployment evaluation, 2026-04-28) — env template.
#
# Copy to `.env.r2` and replace the change-me-... placeholders with real
# secrets. `.env.r2` is gitignored (see .gitignore note at the bottom).
# `.env.r2.example` is checked in as the schema reference.
#
# Lifecycle:
#
#   cp .env.r2.example .env.r2
#   ./scripts/r2-up.sh       # reads .env.r2, issues HARNESS_RUN_JWT
#   ./scripts/r2-eval.sh     # exercises handshake → WS hello
#   ./scripts/r2-down.sh
#
# Threat model assumed for these values:
#
#   - .env.r2 lives on the operator's machine ONLY. Never committed.
#   - HARNESS_TOKEN is the master HKDF input — leaking it lets an
#     attacker mint runJWTs accepted by the orchestrator and forge
#     audit-ledger HMAC signatures. Treat as root credential.
#   - RUNNER_BOOTSTRAP_TOKEN is single-use per host (see
#     RunnerRegistry handshake). Replay → bootstrap_consumed.
#

# ── orchestrator master secret ─────────────────────────────────────
# IKM for HKDF derivation of:
#   - jwtKey       (info="runner-jwt"   — HS256 key for runJWT issue/verify)
#   - ledgerKey    (info="audit-ledger" — HMAC-SHA256 key for evidenceLedger.sig)
# Both derived from this single value with domain separation, so leaking
# one cannot forge the other (RFC 5869 separation property).
# Recommended: 32+ bytes of randomness.
HARNESS_TOKEN=change-me-32-bytes-of-randomness-please-replace

# ── remote subsystem feature flag ──────────────────────────────────
# off     — subsystem dormant; runner routes 404 (default in non-eval deployments)
# preview — full subsystem on; HKDF keys derived; routes mounted
# on      — same as preview but reserved for stricter R2+ posture
HARNESS_REMOTE_MODE=preview

# ── Slice R2.5-c: hook execution bridge mode ──────────────────────
# off (default)  — broadcast-only; remote hooks NEVER drive the local
#                  executor. R1/R2 behavior; safest upgrade default.
# report         — sanitization runs; audit chain emits sanitized /
#                  rejected verbs but NO dispatch. Use for 24-48h
#                  preview before promoting to "dispatch".
# dispatch       — sanitized hooks (PreToolUse / PostToolUse /
#                  Stop / SubagentStart / SubagentStop with tools in
#                  Read/Grep/Glob) are forwarded to local executor.
#                  Bash / Write / Edit are still rejected — R3 will
#                  add a per-call approval flow before opening them.
HARNESS_REMOTE_BRIDGE_MODE=off

# ── runner host identity + bootstrap ───────────────────────────────
# The orchestrator's RunnerRegistry maps this identity → bootstrap token
# via env var HARNESS_REMOTE_RUNNER_TOKEN_<sanitized-identity>. The
# compose file already wires this for HARNESS_HOST_IDENTITY=runner-r2-001
# (sanitized = runner_r2_001). If you change HARNESS_HOST_IDENTITY,
# update compose accordingly.
HARNESS_HOST_IDENTITY=runner-r2-001

# Bootstrap token. Same value flows into:
#   - orchestrator: HARNESS_REMOTE_RUNNER_TOKEN_runner_r2_001
#   - runner:       HARNESS_BOOTSTRAP_TOKEN
# Single-use per (orchestrator process, host identity) pair. Refresh by
# bouncing the orchestrator with a new value.
RUNNER_BOOTSTRAP_TOKEN=change-me-bootstrap-32-bytes-please-replace

# ── per-run identity ───────────────────────────────────────────────
# R1 = single-run-per-process. The runJWT below is issued for THIS runId
# only; switching runId requires re-issuing.
HARNESS_RUN_ID=rr-r2-eval-001

# ── runJWT (auto-issued by r2-up scripts) ──────────────────────────
# Leave blank in .env.r2.example. scripts/r2-up.{sh,ps1} mints this from
# HARNESS_TOKEN + HARNESS_RUN_ID + HARNESS_HOST_IDENTITY using
# src/security/jwt.js, then writes it back into .env.r2 before invoking
# `docker compose up`. The runner reads it from env at boot.
HARNESS_RUN_JWT=

# ── (optional) tunables ────────────────────────────────────────────
# Uncomment + set to override.
# HARNESS_HEARTBEAT_INTERVAL_MS=5000
# HARNESS_RECONNECT_BASE_MS=1000
# HARNESS_RECONNECT_MAX_MS=30000

# ──────────────────────────────────────────────────────────────────
# Note: .env.r2 (the filled-in copy) is gitignored. Verify with:
#   grep "^\.env\.r2$" .gitignore || echo "WARNING: add .env.r2 to .gitignore"
# Only this template (.env.r2.example) is committed.
